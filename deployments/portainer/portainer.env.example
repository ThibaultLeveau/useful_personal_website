# Upload a completed copy of this file in Portainer's stack environment section.
# Never commit the completed file. Every value ending in PASSWORD or KEY must be unique.

COMPOSE_PROJECT_NAME=useful-personal-website
BACKEND_IMAGE=ghcr.io/thibaultleveau/useful-personal-website-backend
FRONTEND_IMAGE=ghcr.io/thibaultleveau/useful-personal-website-frontend
IMAGE_TAG=replace-with-the-tag-you-pushed

POSTGRES_DB=useful_personal_website
POSTGRES_USER=useful_cluster_admin
POSTGRES_PASSWORD=
POSTGRES_MIGRATION_USER=useful_migration_owner
POSTGRES_MIGRATION_PASSWORD=
POSTGRES_RUNTIME_USER=useful_runtime
POSTGRES_RUNTIME_PASSWORD=
POSTGRES_AUDIT_OPERATOR_USER=useful_audit_operator
POSTGRES_AUDIT_OPERATOR_PASSWORD=

APP_BUILD_VERSION=1.0.0
APP_BUILD_COMMIT=replace-with-full-lowercase-git-commit
APP_CSRF_SIGNING_KEY=
APP_TOKEN_DIGEST_PEPPER=
APP_PRIVACY_HMAC_KEY=
