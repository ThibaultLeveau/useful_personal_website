# Copy this file to .env for local Compose use, then replace every blank value.
# Do not commit .env. Use distinct URL-safe random values of at least 32
# characters because the owner/runtime passwords are embedded in local async
# PostgreSQL URLs. POSTGRES_USER is a bootstrap-only cluster administrator; the
# backend never receives it.

COMPOSE_PROJECT_NAME=useful-personal-website
IMAGE_TAG=local
BACKEND_PORT=8000
FRONTEND_PORT=3000
# Server-only Next.js fallback proxy target for local/container use. Production
# should normally route /api/v1 at the TLS edge before a request reaches Next.js.
UPW_API_UPSTREAM_ORIGIN=http://backend:8000
# Required for production canonical URLs, social metadata, robots, and sitemap output.
# Use only the externally visible origin; do not include a path, query, or credentials.
UPW_PUBLIC_SITE_ORIGIN=http://localhost:3000

POSTGRES_DB=useful_personal_website
POSTGRES_USER=useful_cluster_admin
POSTGRES_PASSWORD=
POSTGRES_MIGRATION_USER=useful_migration_owner
POSTGRES_MIGRATION_PASSWORD=
POSTGRES_RUNTIME_USER=useful_runtime
POSTGRES_RUNTIME_PASSWORD=
POSTGRES_AUDIT_OPERATOR_USER=useful_audit_operator
POSTGRES_AUDIT_OPERATOR_PASSWORD=

APP_ENVIRONMENT=development
APP_BUILD_VERSION=0.0.0
APP_BUILD_COMMIT=unknown
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_TRUSTED_ORIGINS=[]

# Development defaults to the private mounted local volume. A single-host production
# deployment may use the same private persistent volume only when the explicit
# acknowledgement is true and coordinated backups include it. Use S3-compatible
# storage before horizontal scaling; never expose provider credentials to the frontend.
APP_MEDIA_STORAGE_KIND=local
APP_MEDIA_LOCAL_ROOT=/app/media
APP_MEDIA_LOCAL_PRODUCTION_ACKNOWLEDGED=false
APP_MEDIA_S3_ENDPOINT_URL=
APP_MEDIA_S3_REGION=
APP_MEDIA_S3_BUCKET=
APP_MEDIA_S3_MANAGED_PREFIX=
APP_MEDIA_S3_AUTH_SOURCE=
APP_MEDIA_S3_ENCRYPTION=
APP_MEDIA_S3_KMS_KEY_ID=
APP_MEDIA_S3_CONNECT_TIMEOUT_SECONDS=
APP_MEDIA_S3_READ_TIMEOUT_SECONDS=

# Populate only when APP_MEDIA_S3_AUTH_SOURCE=environment. Prefer deployment
# workload identity where the selected platform supports it.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# These values are optional in development and required in production. Generate
# independent values containing at least 32 random bytes; never reuse them.
APP_CSRF_SIGNING_KEY=
APP_TOKEN_DIGEST_PEPPER=
APP_PRIVACY_HMAC_KEY=
APP_TOKEN_DIGEST_KEY_VERSION=development-v1
APP_CONTACT_POLICY_VERSION=development-policy-v1
APP_CONTACT_PSEUDONYM_KEY_VERSION=development-v1
APP_CONTACT_RETENTION_DAYS=365

# Operator commands only. Never inject this URL into the web application.
APP_AUDIT_RETENTION_DATABASE_URL=
APP_AUDIT_RETENTION_DAYS=400
